# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- required ---
# From @BotFather: /newbot
TELEGRAM_TOKEN=123456789:replace-with-your-bot-token
# Absolute path to the Claude Code CLI (run `which claude` in a login shell)
CLAUDE_BIN=/home/you/.local/bin/claude

# --- recommended ---
# Your numeric Telegram user id (message @userinfobot). Only this user is served.
# If unset, the first person to send /start claims the bot.
OWNER_ID=
# How Sarge refers to you in its prompts
SARGE_USER_NAME=Alex

# --- optional ---
CLAUDE_MODEL=sonnet
SARGE_TZ=America/Vancouver
TARGET_KCAL=1800
TARGET_PROTEIN=130
TARGET_WATER_ML=3000
TARGET_STEPS=8000
# SARGE_DB=/path/to/sarge.db   (default: ./data/sarge.db)

# Google Sheet mirror (see README). Leave SHEET_WEBHOOK_URL empty to disable.
SHEET_WEBHOOK_URL=
SHEET_SECRET=
